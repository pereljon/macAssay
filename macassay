  w=$(chain_writable "$f" "$prog" "$tgt" "$script")
  if [ -n "$w" ]; then
    NRW=$((NRW+1)); finding MA-PERSISTENCE-004 "${w%%$'\t'*}" Persistence "Root daemon $(basename "$f") runs $prog${script:+ $script}, and ${w#*$'\t'}. Whoever can change it can replace what runs as root."
  fi
