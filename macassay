ls -l /Library/PrivilegedHelperTools 2>/dev/null | tail -n +2 | while read -r l; do f="/Library/PrivilegedHelperTools/${l##* }"; echo "$l  [$(sig "$f")]"; done | block "Privileged helper tools"
