  echo "Searching 7 days of logs (this can take a few minutes)..." >&2
  XP=$(log show --last 7d --style compact --predicate 'subsystem BEGINSWITH "com.apple.XProtect" AND (eventMessage CONTAINS[c] "detected" OR eventMessage CONTAINS[c] "remediat")' 2>/dev/null | grep -viE 'NoThreatDetected|no (threats|detections)|status: 0|^Timestamp ' | tail -20; exit "${PIPESTATUS[0]}"); XPRC=$?
  XN=$(log show --last 7d --style compact --predicate 'subsystem BEGINSWITH "com.apple.XProtect" AND eventMessage CONTAINS "NoThreatDetected"' 2>/dev/null | grep -c NoThreatDetected; exit "${PIPESTATUS[0]}"); XNRC=$?
  if [ "$XPRC" -ne 0 ] || [ "$XNRC" -ne 0 ]; then skip "XProtect log search" "log show failed"; say "- XProtect detections (7 days): unreadable (log show failed)"
  else
    say "- XProtect scanner results reporting NoThreatDetected (7 days): $XN"
    if [ -n "$XP" ]; then echo "$XP" | block "XProtect detection or remediation messages (7 days)"; finding MA-EVENTS-001 HIGH Events "XProtect logged detection or remediation messages (see section 14)."; else say "- XProtect detections (7 days): none found"; fi
  fi
  SS=$(log show --last 7d --style compact --predicate 'process BEGINSWITH "sshd" AND (eventMessage CONTAINS "Failed" OR eventMessage CONTAINS "Invalid user" OR eventMessage CONTAINS "Accepted")' 2>/dev/null); SSRC=$?
  if [ "$SSRC" -ne 0 ]; then skip "SSH log search" "log show failed"; say "- SSH log lines (7 days): unreadable (log show failed)"
  else
    say "- SSH log lines (7 days): accepted $(echo "$SS" | grep -c Accepted), failed $(echo "$SS" | grep -c Failed), invalid user $(echo "$SS" | grep -c 'Invalid user'). Without admin rights these lines are often hidden."
    NF=$(echo "$SS" | grep -c -E 'Failed|Invalid user'); [ "$NF" -ge 20 ] && finding MA-EVENTS-002 MEDIUM Events "$NF failed SSH sign-in attempts in 7 days."
  fi
else say "Log searches skipped (--quick)."; skip "7-day log searches (XProtect, SSH)" "--quick"; fi

sect_end
# ---------- assemble report ----------
NPR=$(grep -c . "$TMP/privran"); NPS=$(grep -c '^priv' "$SKIPS"); NOS=$(grep -c '^other' "$SKIPS")
write_meta
total_status
if [ "$BUNDLE" -eq 1 ]; then write_bundle "$TMP"; exit $?; fi
render_all "$TMP"; exit $?
