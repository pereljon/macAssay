git_hooks_path() { awk '/^[[:space:]]*\[/ { s = tolower($0); gsub(/[[:space:]]/, "", s); next }
  s ~ /^\[core\]/ && tolower($0) ~ /^[[:space:]]*hookspath[[:space:]]*=/ { v = $0; sub(/^[^=]*=[[:space:]]*/, "", v); print v }' "$1" 2>/dev/null; }
# shellcheck disable=SC2317  # exit runs when the script is executed, not sourced, with MACASSAY_LIB=1.
[ "${MACASSAY_LIB:-}" = 1 ] && { return 0 2>/dev/null || exit 0; }

# ---------- options and mode ----------
OUT=""; QUICK=0; OFFLINE=0; SKIPDU=0; STDOUT=0; MODE=""; SUSER=""
DEFBASE=""; FORMATS=md; OUTOPTS=""; ACCEPTED=""; COMPARE=""; FAILON=""; BUNDLE=0
RHOST=""; RUSER=""; RKEY=""; RPORT=""; RKH=""
need() { [ $# -ge 2 ] || die "Option $1 needs a value (see -h)." 2; }
setmode() { [ -z "$MODE" ] || [ "$MODE" = "$1" ] || die "--$MODE and --$1 cannot be combined." 2; MODE="$1"; }
optuser() { case "$1" in *=*) SUSER="${1#*=}" ;; esac
  [ -z "$SUSER" ] || valid_name "$SUSER" || die "Not a valid user name: $SUSER" 2; }
while [ $# -gt 0 ]; do
  case "$1" in
    -o) need "$@"; OUT="$2"; OUTOPTS="$OUTOPTS -o"; shift 2 ;;
    --quick) QUICK=1; shift ;;
    --offline) OFFLINE=1; shift ;;
    --skip-du) SKIPDU=1; shift ;;
    --stdout) STDOUT=1; OUTOPTS="$OUTOPTS --stdout"; shift ;;
    --format) need "$@"; FORMATS="$2"; OUTOPTS="$OUTOPTS --format"; shift 2 ;;
    --accepted) need "$@"; ACCEPTED="$2"; OUTOPTS="$OUTOPTS --accepted"; shift 2 ;;
    --compare) need "$@"; COMPARE="$2"; OUTOPTS="$OUTOPTS --compare"; shift 2 ;;
    --fail-on) need "$@"; FAILON="$2"; OUTOPTS="$OUTOPTS --fail-on"; shift 2 ;;
    --bundle) BUNDLE=1; shift ;;
    --host) need "$@"; RHOST="$2"; shift 2 ;;
    --user) need "$@"; RUSER="$2"; shift 2 ;;
    --key) need "$@"; RKEY="$2"; shift 2 ;;
    --port) need "$@"; RPORT="$2"; shift 2 ;;
    --known-hosts) need "$@"; RKH="$2"; shift 2 ;;
    --print-sudoers|--print-sudoers=*) setmode print-sudoers; optuser "$1"; shift ;;
    --install-sudoers|--install-sudoers=*) setmode install-sudoers; optuser "$1"; shift ;;
    -h|--help) [ -f "$0" ] || die "Help needs the script file."
               awk 'NR > 1 && /^#/ {sub(/^# ?/, ""); print; next} NR > 1 {exit}' "$0"; exit 0 ;;
    --version) echo "macassay $VERSION"; exit 0 ;;
    *) die "Unknown option: $1 (see -h)" 2 ;;
  esac
done

FMTS=$(check_formats "$FORMATS") || die "Unknown format in --format: $FORMATS (use md, json, ocsf, html, or csv)." 2
case " $OUTOPTS " in *" --fail-on "*) case "$FAILON" in high|medium|low|info) ;; *) die "--fail-on takes high, medium, low, or info." 2 ;; esac ;; esac
if [ -n "$MODE" ] && [ -n "$OUTOPTS" ]; then die "--$MODE cannot be combined with$OUTOPTS." 2; fi
case "$FMTS" in *" "*) [ "$STDOUT" -eq 0 ] || die "--stdout works with one format only." 2 ;; esac
case " $FMTS " in *" md "*|*" html "*|*" json "*) ;; *) [ -z "$COMPARE" ] || die "--compare needs md, html, or json in --format." 2 ;; esac
if [ "$BUNDLE" -eq 1 ]; then
  [ -z "$OUTOPTS" ] || die "--bundle cannot be combined with$OUTOPTS." 2
  [ -z "$RHOST" ] || die "--bundle and --host cannot be combined." 2
fi

TMP=$(mktemp -d /tmp/macassay.XXXXXX) || exit 1
trap 'rm -rf "$TMP"' EXIT

if [ "$(id -u)" -eq 0 ] && { [ "$MODE" != install-sudoers ] || [ -n "$RHOST" ]; }; then
  die "macassay runs as root only for --install-sudoers on this Mac. Run the audit as a normal user; privileged checks use the macassay sudo rules (see -h)." 2
fi
if [ -n "$ACCEPTED" ]; then load_accepted "$ACCEPTED" > "$TMP/acc.tsv" || exit 2; fi
if [ -n "$COMPARE" ]; then compare_load "$COMPARE" || exit 2; fi
if [ -n "$RHOST" ]; then remote_mode; fi
case "$MODE" in
  print-sudoers) print_sudoers_mode ;;
  install-sudoers) install_mode ;;
esac

# ---------- audit ----------
HOST=$(scutil --get LocalHostName 2>/dev/null || hostname -s)
NOW=$(date "+%Y-%m-%d %H:%M %Z")
EPOCH=$(date +%s)
DEFBASE="./macassay-${HOST}-$(date +%Y%m%d-%H%M)"
TUSER="$(id -un)"
THOME=$(dscl . -read "/Users/$TUSER" NFSHomeDirectory 2>/dev/null | awk '{print $2}'); [ -n "$THOME" ] || THOME="$HOME"
BODY="$TMP/body.md"; FIND="$TMP/findings.tsv"; SKIPS="$TMP/skipped.tsv"
: > "$BODY"; : > "$FIND"; : > "$SKIPS"; : > "$TMP/privran"
LANIF=$(route -n get default 2>/dev/null | awk '/interface:/{print $2}')
LANIP=$(ipconfig getifaddr "${LANIF:-en0}" 2>/dev/null)
read_enrollment
priv "lsof listeners" /usr/sbin/lsof -nP -iTCP -sTCP:LISTEN > "$TMP/lsofl" 2>/dev/null && LSOFL=1 || LSOFL=0
if /usr/sbin/sshd -G > "$TMP/sshdg" 2>/dev/null; then SSHDG=1; else SSHDG=0; skip "Effective sshd settings" "sshd -G failed"; fi


# ---------- 1. System health ----------
h2 "1. System health"
h3 "System and hardware"
run "macOS" sw_vers
run "Kernel" uname -a
HW=$(system_profiler SPHardwareDataType 2>/dev/null)
printf '%s\n' "$HW" | grep -vE 'Serial|UUID|UDID|^\s*$' | block "Hardware (serial and UUIDs omitted)"
run "Uptime and load" uptime
h3 "Memory"
MEMGB=$(( $(sysctl -n hw.memsize) / 1073741824 ))
SW=$(sysctl -n vm.swapusage)
say "- Installed memory: ${MEMGB} GB"; say "- Swap: \`$SW\`"
SWT=$(echo "$SW" | awk '{gsub("M","",$3); print int($3)}'); SWU=$(echo "$SW" | awk '{gsub("M","",$6); print int($6)}')
if [ "${SWT:-0}" -gt 0 ] && [ $(( SWU * 100 / SWT )) -ge 75 ]; then finding MA-HEALTH-001 LOW Health "Swap ${SWU} of ${SWT} MB used ($(( SWU * 100 / SWT ))%)."; fi
run "Memory pressure" sh -c 'memory_pressure | tail -2; vm_stat | grep -E "Pageouts|Swapouts"'
ps -axo rss=,pcpu=,pid=,user=,comm= | sort -rn | head -15 | top_mem | block "Top 15 processes by memory"
ps -axo pcpu=,rss=,pid=,comm= | sort -rn | head -10 | block "Top 10 processes by CPU"
if readable /Library/Logs/DiagnosticReports "Jetsam reports" && readable "$THOME/Library/Logs/DiagnosticReports" "Jetsam reports"; then
  JET=$(find /Library/Logs/DiagnosticReports "$THOME/Library/Logs/DiagnosticReports" -name 'JetsamEvent-*' -mtime -7 2>/dev/null | wc -l | tr -d ' ')
  say "- Out-of-memory (Jetsam) reports in the last 7 days: $JET"
  [ "$JET" -ge 3 ] && finding MA-HEALTH-002 MEDIUM Health "$JET out-of-memory (Jetsam) events in 7 days; macOS is killing processes to free memory."
else say "- Out-of-memory (Jetsam) reports in the last 7 days: unreadable (DiagnosticReports folder not readable)"; fi
h3 "Storage"
run "Volumes" df -h / /System/Volumes/Data
DPCT=$(df -k /System/Volumes/Data | awk 'NR==2{gsub("%","",$5); print $5}')
DFREE=$(df -k /System/Volumes/Data | awk 'NR==2{printf "%.1f", $4/1048576}')
if [ "${DPCT:-0}" -ge 95 ]; then finding MA-HEALTH-003 HIGH Health "Data volume ${DPCT}% used, ${DFREE} GB free.";
elif [ "${DPCT:-0}" -ge 85 ]; then finding MA-HEALTH-003 MEDIUM Health "Data volume ${DPCT}% used, ${DFREE} GB free."; fi
system_profiler SPStorageDataType 2>/dev/null | grep -E 'Mount Point|Device Name|S.M.A.R.T|Capacity|Free' | mask_hex | block "Drives and SMART status"
system_profiler SPStorageDataType 2>/dev/null | grep 'S.M.A.R.T' | grep -qv Verified && finding MA-HEALTH-004 HIGH Health "A drive reports a SMART status other than Verified."
h3 "Crash reports"
find /Library/Logs/DiagnosticReports "$THOME/Library/Logs/DiagnosticReports" -type f -mtime -14 2>/dev/null | crash_kinds | block "Crash and diagnostic reports, last 14 days (count by kind)"
if readable /Library/Logs/DiagnosticReports "Kernel panics"; then
  NP=$(find /Library/Logs/DiagnosticReports -name '*.panic' -mtime -30 2>/dev/null | wc -l | tr -d ' ')
  say "- Kernel panics in 30 days: $NP"; [ "$NP" -gt 0 ] && finding MA-HEALTH-005 HIGH Health "$NP kernel panic(s) in the last 30 days."
else say "- Kernel panics in 30 days: unreadable (DiagnosticReports folder not readable)"; fi
h3 "Disk usage"
if [ "$SKIPDU" -eq 0 ]; then
  echo "Measuring home folder usage..." >&2
  ( cd "$THOME" && du -sh -x -- .[!.]* * Library/* 2>/dev/null | sort -rh | head -25 ) | block "Largest items in $THOME (top 25)"
  : > "$TMP/du"
  priv "du /Users" /usr/bin/du -h -d 1 -x /Users >> "$TMP/du" 2>/dev/null
  priv "du system folders" /usr/bin/du -sh -x /Library /Applications /opt /private/var >> "$TMP/du" 2>/dev/null
  if [ -s "$TMP/du" ]; then grep -v '^du:' "$TMP/du" | sort -rh | block "Top-level usage"
  else say "- Top-level usage: skipped ($(skip_reason "du /Users"))"; fi
else say "Skipped (--skip-du)."; skip "Disk usage" "--skip-du"; fi
h3 "Power"
run "Power and sleep" pmset -g
HASBAT=0; pmset -g batt 2>/dev/null | grep -q InternalBattery && HASBAT=1
if [ "$HASBAT" = 1 ]; then
  system_profiler SPPowerDataType 2>/dev/null | grep -E '^[[:space:]]*(Condition|Maximum Capacity):' | sed 's/^[[:space:]]*//' > "$TMP/bat"
  block "Battery" < "$TMP/bat"
  BCAP=$(awk -F': ' '/^Maximum Capacity/ {gsub("%", "", $2); print $2 + 0; exit}' "$TMP/bat")
  BCOND=$(awk -F': ' '/^Condition/ {print $2; exit}' "$TMP/bat")
  if { [ -n "$BCAP" ] && [ "$BCAP" -lt 80 ]; } || { [ -n "$BCOND" ] && [ "$BCOND" != Normal ]; }; then
    finding MA-HEALTH-006 LOW Health "Battery health: condition ${BCOND:-unknown}, maximum capacity ${BCAP:-unknown}%."; fi
else say "- Battery: none"; fi

# ---------- 2. Backups ----------
h2 "2. Backups"
run "Local snapshots" tmutil listlocalsnapshots /
NSNAP=$(tmutil listlocalsnapshots / 2>/dev/null | grep -c TimeMachine)
TMP_PL=/Library/Preferences/com.apple.TimeMachine.plist
TMDEST=$(tmutil destinationinfo 2>/dev/null | awk -F': ' '/^Name/{print $2}' | paste -sd, -); TMRC=0
TMU=""
if [ -e "$TMP_PL" ] && ! plutil -lint "$TMP_PL" >/dev/null 2>&1; then
  skip "Time Machine backup age and encryption" "settings file unreadable; needs Full Disk Access for the terminal app"
  TMU="unreadable (needs Full Disk Access for the terminal app)"
elif [ -n "$TMDEST" ] && [ ! -e "$TMP_PL" ]; then
  skip "Time Machine settings" "settings file missing while a destination exists"; TMU="unreadable (settings file missing)"
fi
NSD=$(plutil -extract Destinations.0.SnapshotDates raw -o - "$TMP_PL" 2>/dev/null)
LASTBK=""; [ -n "$NSD" ] && [ "$NSD" -gt 0 ] 2>/dev/null && LASTBK=$(plutil -extract "Destinations.0.SnapshotDates.$((NSD-1))" raw -o - "$TMP_PL" 2>/dev/null)
TMENC=$(plutil -extract Destinations.0.LastKnownEncryptionState raw -o - "$TMP_PL" 2>/dev/null)
if [ "$TMRC" -eq 0 ]; then say "- Time Machine destinations: ${TMDEST:-none}"; else say "- Time Machine destinations: unreadable (tmutil destinationinfo failed)"; fi
say "- Local snapshots: $NSNAP"
say "- Latest backup on first destination: ${LASTBK:-${TMU:-unknown}} (UTC); backups recorded: ${NSD:-${TMU:-unknown}}"
say "- First destination encryption: ${TMENC:-${TMU:-unknown}}"
[ "$TMRC" -eq 0 ] && [ -z "$TMDEST" ] && finding MA-BACKUPS-001 MEDIUM Backups "No Time Machine destination configured."
[ "$TMENC" = "NotEncrypted" ] && finding MA-BACKUPS-002 MEDIUM Backups "Time Machine disk is not encrypted."
if [ -n "$LASTBK" ]; then
  AGE=$(( ( $(date +%s) - $(date -j -u -f "%Y-%m-%dT%H:%M:%SZ" "$LASTBK" +%s 2>/dev/null || date +%s) ) / 3600 ))
  say "- Hours since latest backup: $AGE"; [ "$AGE" -ge 48 ] && finding MA-BACKUPS-003 MEDIUM Backups "Latest Time Machine backup is $AGE hours old."
fi
if [ -n "$TMDEST" ]; then
  pref com.apple.TimeMachine AutoBackup "$(defaults read /Library/Preferences/com.apple.TimeMachine AutoBackup 2>/dev/null)"; AB="$PV"
  pref_line "Automatic backups (AutoBackup)" "1, on"
  [ "$AB" = 0 ] && finding MA-BACKUPS-004 MEDIUM Backups "Time Machine has a destination, but automatic backups are off." "$PSRC"
  EXC=$(tmutil isexcluded "$THOME" 2>/dev/null | awk '{print $1}')
  say "- Home folder in Time Machine: ${EXC:-unknown}"
  [ "$EXC" = "[Excluded]" ] && finding MA-BACKUPS-005 MEDIUM Backups "The home folder is excluded from Time Machine."
fi

# ---------- 3. Updates and installs ----------
h2 "3. Updates and installs"
SUP=/Library/Preferences/com.apple.SoftwareUpdate
supd() { defaults read "$SUP" "$1" 2>/dev/null; }
SUD=com.apple.SoftwareUpdate
say "**Software Update settings**"; say ""
pref $SUD AutomaticCheckEnabled "$(supd AutomaticCheckEnabled)"; ACE="$PV"; ACE_S="$PSRC"; pref_line "Automatic checks (AutomaticCheckEnabled)" "1, on"
LFS=$(supd LastFullSuccessfulDate); default_line "Last full successful check (LastFullSuccessfulDate)" "$LFS" "unknown"
pref $SUD AutomaticDownload "$(supd AutomaticDownload)"; ADL="$PV"; ADL_S="$PSRC"; pref_line "Automatic download (AutomaticDownload)" "1, on"
pref $SUD AutomaticallyInstallMacOSUpdates "$(supd AutomaticallyInstallMacOSUpdates)"; AIM="$PV"; AIM_S="$PSRC"
pref_line "Install macOS updates automatically (AutomaticallyInstallMacOSUpdates)" "0, off"
pref $SUD CriticalUpdateInstall "$(supd CriticalUpdateInstall)"; CUI="$PV"; CUI_S="$PSRC"; pref_line "Security responses and system files (CriticalUpdateInstall)" "1, on"
pref $SUD ConfigDataInstall "$(supd ConfigDataInstall)"; CDI="$PV"; CDI_S="$PSRC"; pref_line "XProtect and other data updates (ConfigDataInstall)" "1, on"
pref com.apple.commerce AutoUpdate "$(defaults read /Library/Preferences/com.apple.commerce AutoUpdate 2>/dev/null)"; ASU="$PV"; ASU_S="$PSRC"
pref_line "App Store app updates (com.apple.commerce AutoUpdate)" "1, on"
LFSD=""; [ -n "$LFS" ] && LFSD=$(( ( $(date +%s) - $(date -j -u -f '%Y-%m-%d %H:%M:%S +0000' "$LFS" +%s 2>/dev/null || date +%s) ) / 86400 ))
if [ "$ACE" = 0 ]; then finding MA-UPDATES-003 MEDIUM Updates "Automatic software update checks are off." "$ACE_S"
elif [ -n "$LFSD" ] && [ "$LFSD" -gt 30 ]; then finding MA-UPDATES-003 MEDIUM Updates "The last full software update check was $LFSD days ago."; fi
S="$(src_if "$CUI" "$CUI_S" 0)$(src_if "$CDI" "$CDI_S" 0)"
{ [ "$CUI" = 0 ] || [ "$CDI" = 0 ]; } && finding MA-UPDATES-004 MEDIUM Updates "Security responses (CriticalUpdateInstall=${CUI:-default}) or XProtect data updates (ConfigDataInstall=${CDI:-default}) are off." "${S:+managed}"
S="$(src_if "$ADL" "$ADL_S" 0)$(src_if "$ASU" "$ASU_S" 0)"
{ [ "$ADL" = 0 ] || [ "$ASU" = 0 ]; } && finding MA-UPDATES-006 LOW Updates "Automatic download of macOS updates (${ADL:-default}) or App Store auto-update (${ASU:-default}) is off." "${S:+managed}"
[ "$AIM" = 1 ] || finding MA-UPDATES-007 INFO Updates "macOS updates are not installed automatically." "$AIM_S"
BREW=""; for b in /opt/homebrew/bin/brew /usr/local/bin/brew; do [ -x "$b" ] && { BREW="$b"; break; }; done
if [ "$OFFLINE" -eq 0 ]; then
  SU=$(softwareupdate -l 2>&1); echo "$SU" | block "softwareupdate -l"
  echo "$SU" | grep -q '^\* Label' && finding MA-UPDATES-001 MEDIUM Updates "macOS updates are available: $(echo "$SU" | awk -F': ' '/^\* Label/{print $2}' | paste -sd';' -)"
  if [ -n "$BREW" ]; then
    OBF=$("$BREW" outdated --quiet --formula 2>/dev/null); R1=$?; OBC=$("$BREW" outdated --quiet --cask 2>/dev/null); R2=$?
    if [ "$R1" -ne 0 ] || [ "$R2" -ne 0 ]; then skip "Homebrew outdated packages" "brew outdated failed"; say "- Outdated Homebrew packages: unreadable (brew outdated failed)"
    else
      OBG=$(greedy_only "$OBC" "$("$BREW" outdated --quiet --cask --greedy 2>/dev/null)")
      NBF=$(printf '%s' "$OBF" | grep -c .); NBC=$(printf '%s' "$OBC" | grep -c .); NB=$(( NBF + NBC ))
      printf '%s' "$OBF" | block "Outdated Homebrew formulae ($NBF)"
      printf '%s' "$OBC" | block "Outdated Homebrew casks ($NBC)"
      printf '%s' "$OBG" | block "Casks outdated only under --greedy: they update themselves or track latest ($(printf '%s' "$OBG" | grep -c .))"
      [ "$NB" -ge 20 ] && finding MA-UPDATES-002 LOW Updates "$NB Homebrew packages are outdated ($NBF formulae, $NBC casks)."
    fi
  fi
else say "Skipped (--offline)."; skip "macOS and Homebrew update checks" "--offline"; fi
if [ -n "$BREW" ]; then
  if [ -n "${XDG_CONFIG_HOME:-}" ]; then BUC="$XDG_CONFIG_HOME/homebrew"; elif [ -n "${HOMEBREW_XDG_CONFIG_HOME:-}" ]; then BUC="$HOMEBREW_XDG_CONFIG_HOME/homebrew"; else BUC="$THOME/.homebrew"; fi
  say ""; say "Homebrew security settings (names only; values are never read):"; say ""
  brew_settings /etc/homebrew/brew.env "${BREW%/bin/brew}/etc/homebrew/brew.env" "$BUC/brew.env" | clean >> "$BODY"
  brew_receipts "${BREW%/bin/brew}" > "$TMP/brec"
  tap_packages "$(brew_taps "$(brew_repo "$BREW")")" < "$TMP/brec" > "$TMP/btp"
  sed 's/	/: /' "$TMP/btp" | block "Third-party Homebrew taps and their installed packages"
  tap_findings < "$TMP/btp" | while IFS=$'\t' read -r id sv tx; do finding "$id" "$sv" Updates "$tx"; done
  cask_unquarantined /Applications "$THOME/Applications" < "$TMP/brec" > "$TMP/bnq"
  block "Homebrew cask apps with no quarantine attribute" < "$TMP/bnq"
  [ -s "$TMP/bnq" ] && finding MA-UPDATES-011 LOW Updates "$(grep -c . "$TMP/bnq") Homebrew cask app(s) have no quarantine attribute, so Gatekeeper may not have checked them; an app that updates itself can also remove it: $(sed 's#.*/##' "$TMP/bnq" | paste -sd, -)"
fi
system_profiler SPInstallHistoryDataType 2>/dev/null | xprotect_versions | block "XProtect versions (latest install of each component)"
XPV=$(xprotect version 2>/dev/null); XPRC=$?
XPI=$(printf '%s\n' "$XPV" | sed -n 's/.*Installed: \([0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}\).*/\1/p')
if [ -n "$XPI" ]; then
  XPD=$(( ( $(date +%s) - $(date -j -u -f '%Y-%m-%d' "$XPI" +%s 2>/dev/null || date +%s) ) / 86400 ))
  say "- XProtect installed: $XPI ($XPD days ago)"
  [ "$XPD" -gt 60 ] && finding MA-UPDATES-005 MEDIUM Updates "XProtect was last updated $XPD days ago."
else skip "XProtect version" "xprotect version failed or gave no date (exit $XPRC)"; say "- XProtect installed: unreadable (xprotect version gave no date)"; fi
plutil -p /Library/Receipts/InstallHistory.plist 2>/dev/null | recent_installs "$(date -u -v-30d +%Y-%m-%d)" > "$TMP/inst"
say "- Non-Apple installer packages recorded: $(pkgutil --pkgs 2>/dev/null | grep -vc '^com\.apple\.')"
if [ -s "$TMP/inst" ]; then block "Non-Apple installs in the last 30 days (date, name, version)" < "$TMP/inst"
  finding MA-UPDATES-008 INFO Updates "$(grep -c . "$TMP/inst") non-Apple installs in the last 30 days (see section 3)."
else say "- Non-Apple installs in the last 30 days: none"; fi

# ---------- 4. Platform security ----------
h2 "4. Platform security"
SIP=$(csrutil status 2>&1); FV=$(fdesetup status 2>&1); GK=$(spctl --status 2>&1)
FW=/usr/libexec/ApplicationFirewall/socketfilterfw
FWS=$($FW --getglobalstate 2>&1); FWST=$($FW --getstealthmode 2>&1); FWSIG=$($FW --getallowsigned 2>&1)
pref com.apple.loginwindow autoLoginUser "$(defaults read /Library/Preferences/com.apple.loginwindow autoLoginUser 2>/dev/null)"; AUTOL="$PV"; AUTOL_S="$PSRC"
FWM=""; { managed_val com.apple.security.firewall EnableFirewall >/dev/null || managed_val com.apple.security.firewall BlockAllIncoming >/dev/null; } && FWM=" (managed)"
FWSTM=""; managed_val com.apple.security.firewall EnableStealthMode >/dev/null && FWSTM=" (managed)"
ALM=""; [ "$AUTOL_S" = managed ] && ALM=" (managed)"
printf '%s\n' "$SIP" "$FV" "Gatekeeper: $GK" "$FWS$FWM" "$FWST$FWSTM" "$FWSIG" "Auto-login user: ${AUTOL:-none}$ALM" | block "Baseline"
echo "$SIP" | grep -q enabled || finding MA-PLATFORM-001 HIGH Platform "System Integrity Protection is not enabled."
echo "$GK" | grep -q enabled || finding MA-PLATFORM-002 HIGH Platform "Gatekeeper is disabled."
echo "$FWS" | grep -q 'enabled' || finding MA-PLATFORM-003 MEDIUM Platform "Application firewall is off." "${FWM:+managed}"
case "$FWST" in
  *"stealth mode is on"*) ;;
  *"stealth mode is off"*) finding MA-PLATFORM-004 LOW Platform "Firewall stealth mode is off (the Mac answers probes such as ping)." "${FWSTM:+managed}" ;;
  *) skip "Firewall stealth mode" "socketfilterfw gave no state"; say "- Firewall stealth mode: unreadable (socketfilterfw gave no state)" ;;
esac
echo "$FV" | grep -q 'On' || finding MA-PLATFORM-005 MEDIUM Platform "FileVault is off${AUTOL:+ (auto-login as $AUTOL, which requires FileVault off)}."
[ -n "$AUTOL" ] && finding MA-PLATFORM-006 MEDIUM Platform "Automatic login is on for $AUTOL." "$AUTOL_S"
SL=$(sysadminctl -screenLock status 2>&1 | sed 's/.*\] //')
case "$SL" in
  *immediate*|*[Oo]ff*|*seconds*) say "- Screen lock: $(mdesc "$SL")"; SLR=$(screen_lock_sev "$SL")
    [ -n "$SLR" ] && finding MA-PLATFORM-010 "${SLR%%$'\t'*}" Platform "Screen lock is ${SLR#*$'\t'}." ;;
  *) skip "Screen lock" "sysadminctl gave no screen lock state"; say "- Screen lock: unreadable (sysadminctl gave no state)" ;;
esac
BA=$(nvram boot-args 2>/dev/null | cut -f2-)
say "- Boot arguments: $(mdesc "${BA:-none}")"
case "$(boot_args_sev "$BA")" in
  HIGH) finding MA-PLATFORM-013 HIGH Platform "Boot arguments turn off code-signing enforcement: $BA" ;;
  LOW) finding MA-PLATFORM-014 LOW Platform "Boot arguments are set: $BA" ;;
esac
AR=$(csrutil authenticated-root status 2>&1); say "- $(mdesc "$AR")"
case "$AR" in *disabled*) finding MA-PLATFORM-012 HIGH Platform "The signed system volume (authenticated root) is off." ;; esac
pref com.apple.security.libraryvalidation DisableLibraryValidation "$(defaults read /Library/Preferences/com.apple.security.libraryvalidation DisableLibraryValidation 2>/dev/null)"; LV="$PV"
pref_line "Library validation disabled (DisableLibraryValidation)" "0, library validation on"
[ "$LV" = 1 ] && finding MA-PLATFORM-016 MEDIUM Platform "Library validation is off, so apps can load libraries signed by other developers." "$PSRC"
pref com.apple.LaunchServices LSQuarantine "$(defaults read com.apple.LaunchServices LSQuarantine 2>/dev/null)"; LQ="$PV"
pref_line "Quarantine for downloads (LSQuarantine)" "1, on"
[ "$LQ" = 0 ] && finding MA-PLATFORM-015 HIGH Platform "Quarantine is off (LSQuarantine=0), so Gatekeeper does not check downloaded files." "$PSRC"
FMOK=0
if readable /Library/Preferences/com.apple.FindMyMac.plist "Find My"; then FMOK=1
  pref com.apple.FindMyMac FMMEnabled "$(defaults read /Library/Preferences/com.apple.FindMyMac FMMEnabled 2>/dev/null)"; FMM="$PV"; FMM_S="$PSRC"
  if [ "$FMM_S" = managed ]; then say "- Find My Mac (FMMEnabled): $(mdesc "$FMM") (managed)"; else say "- Find My Mac (FMMEnabled): $(mdesc "${FMM:-not set}")"; fi
else say "- Find My Mac (FMMEnabled): unreadable (settings file not readable)"; fi
AL=$(printf '%s\n' "$HW" | awk -F': ' '/Activation Lock Status/ {print $2; exit}')
say "- Activation Lock: $(mdesc "${AL:-unknown}")"
FMF=""; [ "$FMOK" = 1 ] && FMF=$(findmy_finding "$FMM" "$HASBAT")
