fmt_ext() { case "$1" in md) echo .md ;; json) echo .json ;; ocsf) echo .ocsf.jsonl ;; html) echo .html ;; csv) echo .csv ;; esac; }
# out_paths OUT DEFBASE FORMAT...: prints FORMAT<TAB>PATH. One format with -o writes to OUT as given; otherwise OUT, or
# DEFBASE without OUT, is a base path, with a trailing report extension removed, and each format adds its own extension.
out_paths() { local out="$1" base="$2" f; shift 2
  if [ $# -eq 1 ] && [ -n "$out" ]; then printf '%s\t%s\n' "$1" "$out"; return; fi
  if [ -n "$out" ]; then base="$out"
    case "$base" in *.ocsf.jsonl) base="${base%.ocsf.jsonl}" ;; *.md|*.json|*.jsonl|*.html|*.csv) base="${base%.*}" ;; esac; fi
  for f; do printf '%s\t%s%s\n' "$f" "$base" "$(fmt_ext "$f")"; done; }
# render_one FORMAT R: prints one format on stdout.
render_one() { case "$1" in md) render_md "$2" ;; csv) render_csv "$2" ;; json|ocsf) osascript -l JavaScript -e "$REPORT_JS" "$1" "$2" ;; html) render_html "$2" ;; *) return 1 ;; esac; }
# fail_hit LEVEL ROWS: succeeds when an open finding in ROWS is at or above LEVEL (high, medium, low, or info).
fail_hit() { awk -F'\t' -v l="$1" 'BEGIN { r["HIGH"] = 4; r["MEDIUM"] = 3; r["LOW"] = 2; r["INFO"] = 1; t = r[toupper(l)] }
  t && $7 == 0 && r[$1] >= t {f = 1} END {exit !f}' "$2"; }
# render_all SRC: normalizes, validates, and renders the data files in SRC into every format in FMTS.
# Writes no file unless every format rendered. Returns 0, 1, or 3 (--fail-on).
render_all() { local R="$TMP/render" f p n
  rm -rf "$R"; mkdir "$R" || return 1
  norm_all "$1" "$R" || { echo "Could not normalize the audit data; no report written." >&2; return 1; }
  validate_all "$R"; load_meta "$R"; accept_rows "$R"
  if [ -n "$COMPARE" ]; then osascript -l JavaScript -e "$REPORT_JS" compare "$R" "$TMP/old.json" > /dev/null || { echo "Could not compare with $COMPARE; no report written." >&2; return 1; }; fi
  limits_lines "$R" > "$R/limits.txt"
  # shellcheck disable=SC2086  # FMTS holds format names that check_formats accepted; splitting is intended
  out_paths "$OUT" "$DEFBASE" $FMTS > "$R/outs"
  while IFS=$'\t' read -r f p; do
    render_one "$f" "$R" > "$R/out.$f" || { echo "Could not build the $f report; no report written." >&2; return 1; }
  done < "$R/outs"
  n=$(awk -F'\t' '$7 == 0' "$R/rows.tsv" | grep -c .)
  while IFS=$'\t' read -r f p; do
    if [ "$STDOUT" -eq 1 ]; then cat "$R/out.$f"; echo "Report sent to stdout ($n findings)" >&2
    else cp "$R/out.$f" "$p" || { echo "Could not write $p." >&2; return 1; }; echo "Report written to $p ($n findings)" >&2; fi
  done < "$R/outs"
  if [ -n "$FAILON" ] && fail_hit "$FAILON" "$R/rows.tsv"; then return 3; fi
  return 0; }
