  $'.aws/credentials\t^[[:space:]]*(aws_secret_access_key|aws_session_token)[[:space:]]*=[[:space:]]*[^$[:space:]]' \
  $'.git-credentials\t[^[:space:]]' \
  $'.npmrc\t(_authToken|_auth|_password)[[:space:]]*=[[:space:]]*[^$[:space:]]' \
  $'.pypirc\t^[[:space:]]*password[[:space:]]*[=:][[:space:]]*[^$[:space:]]' \
  $'.docker/config.json\t"(auth|identitytoken)"[[:space:]]*:[[:space:]]*"[^"$]' \
  $'.kube/config\t^[[:space:]]*(token|password|client-key-data):[[:space:]]*[^$[:space:]]' \
  $'.config/gh/hosts.yml\t^[[:space:]]*oauth_token:[[:space:]]*[^$[:space:]]')
