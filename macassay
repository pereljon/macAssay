    elif [ -r "$f" ]; then s="-"; pl="no program"
    else s="-"; pl="unreadable"; fi
    say "| \`$d\` | $(mdesc "$(basename "$f")") | $pl | $(mdesc "$s") | $m |"
    case "$prog" in /tmp/*|/private/tmp/*|/Users/Shared/*|*/.[!.]*/*) finding MA-PERSISTENCE-001 HIGH Persistence "Startup item runs from an unusual path: $f -> $prog";; esac
    [ "$s" = missing ] && [ -n "$prog" ] && case "$prog" in /*) finding MA-PERSISTENCE-002 LOW Persistence "Startup item points to a missing program: $f -> $prog";; esac
