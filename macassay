# remote_places ROOT HOME; prints PLACE<TAB>NAME for each entry, hidden ones too, in the folders where remote-access tools install. ROOT is empty except in tests.
remote_places() { local e
  for e in "app:$1/Applications" "app:$2/Applications" "support folder:$1/Library/Application Support" "opt folder:$1/opt" \
    "launch daemon:$1/Library/LaunchDaemons" "launch agent:$1/Library/LaunchAgents" "launch agent:$2/Library/LaunchAgents" "helper:$1/Library/PrivilegedHelperTools"; do
    find "${e#*:}" -mindepth 1 -maxdepth 1 2>/dev/null | sed "s#.*/#${e%%:*}	#"
