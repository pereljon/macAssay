# remote_support_names; stdin: program paths from ps. Prints the name of each remote-access tool that runs; Apple's own screen sharing server does not count.
remote_support_names() { local ps n d p; ps=$(awk -F/ '{print tolower($NF)}' | grep -vx applevncserver)
  while IFS=$'\t' read -r n d p; do
    if [ "$p" != - ] && printf '%s\n' "$ps" | grep -qE -- "$p"; then echo "$n"; fi
