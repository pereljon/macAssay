# remote_installed; stdin: PLACE<TAB>NAME. Prints TOOL<TAB>PLACES<TAB>ITEMS for each remote-access tool found, where ITEMS
# names each match with its place. VNC viewers do not count.
remote_installed() { local L n d p; L=$(grep -viE 'vnc ?viewer')
  while IFS=$'\t' read -r n d p; do [ "$d" = - ] && continue
    printf '%s\n' "$L" | awk -F'\t' -v re="$d" -v n="$n" 'tolower($2) ~ re {if (!s[$1]++) l = l (l != "" ? ", " : "") $1; i = i (i != "" ? ", " : "") $1 " " $2}
      END {if (l != "") print n "\t" l "\t" i}'
  done <<< "$REMOTE_TOOLS"; }
# remote_installed_findings RUNNING (comma list of tool names); stdin: remote_installed output. Severity comes from the place
# labels only, never from a name on disk. A tool that runs already gives MA-SHARING-013.
remote_installed_findings() { awk -F'\t' -v run=",$1," 'index(run, "," $1 ",") == 0 {print "MA-SHARING-026\t" ($2 ~ /daemon|agent|helper/ ? "MEDIUM" : "LOW") "\t" $1 "\t" $3}'; }
findmy_finding() { [ "$1" = 0 ] || return 0; if [ "$2" = 1 ]; then printf 'MA-PLATFORM-019\tLOW\n'; else printf 'MA-PLATFORM-019\tINFO\n'; fi; }
# brew_settings FILE...; says whether each Homebrew security setting is set, and where: the environment or a brew.env file.
# It never prints a value or a line: brew.env files can hold proxy passwords and tokens.
brew_settings() { local v w f
  for v in HOMEBREW_VERIFY_ATTESTATIONS HOMEBREW_NO_VERIFY_ATTESTATIONS HOMEBREW_NO_INSECURE_REDIRECT; do w=""
    [ -n "$(printenv "$v")" ] && w="environment"
    for f in "$@"; do grep -qE "^[[:space:]]*$v=." "$f" 2>/dev/null && w="${w:+$w, }$f"; done
    if [ -n "$w" ]; then echo "- $v: set ($w)"; else echo "- $v: not set"; fi
