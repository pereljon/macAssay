# forced_ext_note ENROLLED: the enrollment part of the MA-APPS-005 text. Missing evidence must not lower the severity, so
# an unknown state keeps MA-APPS-005 and says so.
forced_ext_note() { if [ "$1" = unknown ]; then printf ' (enrollment state unknown)'; else printf ', and this Mac is not enrolled in MDM'; fi; }
MANAGED_DIR="/Library/Managed Preferences"
# managed_val DOMAIN KEY: prints the value that a profile sets for KEY, device level first, then user level. Reads the named
# key only: managed files can hold device identifiers. plutil prints booleans as true or false; the checks compare 1 and 0.
managed_val() { local f v
  for f in "$MANAGED_DIR/$1.plist" "$MANAGED_DIR/$TUSER/$1.plist"; do
    [ -f "$f" ] || continue
    v=$(plutil -extract "$2" raw -o - "$f" 2>/dev/null) || continue
    case "$v" in true) v=1 ;; false) v=0 ;; esac
    printf '%s' "$v"; return 0
