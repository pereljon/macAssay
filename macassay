# never inside $( ), so the globals survive.
pref() { local v; if v=$(managed_val "$1" "$2"); then PV="$v"; PSRC=managed; else PV="$3"; PSRC=local; fi; }
# pref_line LABEL DEFAULT: the evidence line for the last pref call.
pref_line() { if [ "$PSRC" = managed ]; then say "- $1: $(mdesc "$PV") (managed)"; else default_line "$1" "$PV" "$2"; fi; }
