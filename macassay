# brew_receipts PREFIX; reads every formula and cask receipt under the Homebrew prefix. Runs no brew command, so it never downloads.
brew_receipts() { osascript -l JavaScript -e "$BREW_RECEIPTS_JS" "$1"/Cellar/*/*/INSTALL_RECEIPT.json "$1"/Caskroom/*/.metadata/INSTALL_RECEIPT.json 2>/dev/null | grep .; }
# brew_repo BREW; prints Homebrew's repository folder, which holds Library/Taps: the folder above the target of the bin/brew link
# (/usr/local/Homebrew on Intel), or the prefix when bin/brew is not a link (Homebrew's bin/brew sets HOMEBREW_REPOSITORY so).
brew_repo() { local f="$1" t n=0; while [ -L "$f" ] && [ "$n" -lt 20 ]; do n=$((n + 1)); t=$(readlink "$f"); case "$t" in /*) f="$t" ;; *) f="${f%/*}/$t" ;; esac; done
  (cd "${f%/*}/.." 2>/dev/null && pwd -P); }
# brew_taps REPOSITORY; prints USER/REPO for each installed tap outside homebrew/.
brew_taps() { find "$1/Library/Taps" -mindepth 2 -maxdepth 2 -type d -name 'homebrew-*' 2>/dev/null | awk -F/ '{u = $(NF-1); r = $NF; sub(/^homebrew-/, "", r); if (u != "homebrew") print u "/" r}' | sort -u; }
# tap_packages TAPS; stdin: brew_receipts output. Prints TAP<TAB>PACKAGES for each third-party tap; a tap with no installed package has an empty list.
tap_packages() { sort -t "$(printf '\t')" -k2,2 | awk -F'\t' -v taps="$(printf '%s' "$1" | tr '\n' ' ')" '
  $3 != "-" && $3 !~ /^homebrew\// && !seen[$3 SUBSEP $2]++ {p[$3] = p[$3] (p[$3] != "" ? ", " : "") $2; t[$3] = 1}
  END {n = split(taps, a, " "); for (i = 1; i <= n; i++) t[a[i]] = 1; for (k in t) print k "\t" p[k]}' | sort; }
# tap_findings; stdin: tap_packages output. Prints ID<TAB>SEVERITY<TAB>TEXT.
tap_findings() { awk -F'\t' '$2 == "" {print "MA-UPDATES-009\tLOW\tThe third-party Homebrew tap " $1 " has no installed package. It updates on every brew update but serves nothing."}
  $2 != "" {n = split($2, x, ", "); c += n; l = l (l != "" ? ", " : "") $1 " (" n ")"}
  END {if (c) print "MA-UPDATES-010\tINFO\t" c " installed Homebrew package(s) come from third-party taps: " l}'; }
# cask_unquarantined DIR...; stdin: brew_receipts output. Prints DIR/APP (TOKEN) for each cask app with no quarantine attribute.
cask_unquarantined() { local k t a d
  while IFS=$'\t' read -r k t _ a; do [ "$k" = cask ] || continue
    case "$a" in */*|.*) continue ;; *.app) ;; *) continue ;; esac
    for d in "$@"; do if [ -d "$d/$a" ] && ! xattr -p com.apple.quarantine "$d/$a" >/dev/null 2>&1; then echo "$d/$a ($t)"; fi; done
  done; }
# greedy_only PLAIN GREEDY; prints the names in GREEDY that PLAIN lacks.
greedy_only() { printf '%s\n' "$2" | grep -vxF -f <(printf '%s\n' "$1") | grep .; }
# screen_lock_sev TEXT: prints "SEVERITY<TAB>description" for a screen lock that is off or slow, from sysadminctl -screenLock status.
screen_lock_sev() {
  local s
  case "$1" in *immediate*) return 0 ;; *[Oo]ff*) printf 'MEDIUM\toff\n'; return 0 ;; esac
  s=$(printf '%s' "$1" | sed -n 's/.* \([0-9][0-9]*\) seconds.*/\1/p')
  [ -n "$s" ] || return 0
  if [ "$s" -gt 3600 ]; then printf 'MEDIUM\tset to %s seconds\n' "$s"
  elif [ "$s" -gt 300 ]; then printf 'LOW\tset to %s seconds\n' "$s"; fi; }
# unusual_path PATH: succeeds for a temporary, shared or hidden folder.
unusual_path() { case "$1" in /tmp/*|/private/tmp/*|/private/var/folders/*|/Users/Shared/*|*/.[!.]*/*) return 0 ;; esac; return 1; }
# pam_modules FILE DEPTH: prints each module given as an absolute path outside /usr/lib/pam. Follows include and
# substack targets inside ${PAMD:-/etc/pam.d}; the PAM_SEEN list and a depth limit of 16 stop loops.
pam_modules() {
  local f="$1" depth="$2" ty ctl rest mod
  if [ "$depth" -gt 16 ] || [ ! -f "$f" ]; then return 0; fi
  printf '%s\n' "$PAM_SEEN" | grep -qxF -- "$f" && return 0
  PAM_SEEN="$PAM_SEEN"$'\n'"$f"
  while read -r ty rest; do
    case "$ty" in ''|'#'*) continue ;; esac
    if [ "${rest:0:1}" = "[" ]; then ctl="${rest%%]*}]"; rest="${rest#*]}"
    else ctl="${rest%%[[:space:]]*}"; rest="${rest#"$ctl"}"; fi
    rest="${rest#"${rest%%[![:space:]]*}"}"; mod="${rest%%[[:space:]]*}"
    case "$ctl" in include|substack)
      case "$mod" in */*) ;; ?*) pam_modules "${PAMD:-/etc/pam.d}/$mod" $((depth + 1)) ;; esac; continue ;; esac
    case "$mod" in /usr/lib/pam/*) ;; /*) echo "$mod" ;; esac
  done < "$f"; }
# auth_plugin_finding SIGNER WRITABLE: prints "ID<TAB>SEVERITY" for an authorization plugin; WRITABLE is chain_writable output.
auth_plugin_finding() {
  if [ -n "$2" ]; then printf 'MA-PERSISTENCE-012\t%s\n' "${2%%$'\t'*}"; return; fi
  case "$1" in Apple) ;; unsigned|"ad hoc") printf 'MA-PERSISTENCE-013\tMEDIUM\n' ;; *) printf 'MA-PERSISTENCE-014\tLOW\n' ;; esac; }
