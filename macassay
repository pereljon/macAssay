  $'MA-UPDATES-006\tTurn on automatic downloads in System Settings, General, Software Update, Automatic Updates, and automatic app updates in the App Store settings.' \
  $'MA-UPDATES-007\tDecide whether to turn on automatic installation of macOS updates in System Settings, General, Software Update, or to install them by hand on a schedule.' \
  $'MA-UPDATES-008\tReview the non-Apple installs listed in section 3 and confirm that you recognise each one.' \
  $'MA-UPDATES-009\tRemove the tap with brew untap if nothing needs it; brew untap deletes the tap\'s files from Homebrew.' \
  $'MA-UPDATES-010\tConfirm that you trust each third-party tap that supplies installed packages, because the tap owner controls the code that brew installs from it.' \
  $'MA-UPDATES-011\tCheck that each listed app matches its official download, and reinstall it with brew reinstall --cask NAME, which downloads the app again.')
guidance() { printf '%s\n' "$GUIDANCE" | awk -F'\t' -v i="$1" '$1 == i {print $2; exit}'; }
known_id() { printf '%s\n' "$GUIDANCE" | cut -f1 | grep -qxF -- "$1"; }
# load_accepted FILE: prints ID<TAB>MATCH<TAB>REASON for each entry in an accepted-risk file. The file is read as text,
# never run. A first word that GUIDANCE does not list fails the load, so a typo cannot accept nothing in silence.
load_accepted() { local line id rest match reason n=0
  { [ -f "$1" ] && [ -r "$1" ] && normalize_file "$1" "$TMP/acc.in"; } || { echo "Cannot read the accepted-risk file: $1" >&2; return 1; }
  while IFS= read -r line || [ -n "$line" ]; do n=$((n + 1))
    line="${line#"${line%%[![:space:]]*}"}"
    case "$line" in ''|'#'*) continue ;; esac
    id="${line%%[[:space:]#]*}"; rest="${line#"$id"}"
    case "$rest" in *'#'*) reason="${rest#*#}"; match="${rest%%#*}" ;; *) reason=""; match="$rest" ;; esac
    known_id "$id" || { echo "Line $n of $1: $id is not an ID that macassay gives to a finding." >&2; return 1; }
    printf '%s\t%s\t%s\n' "$id" "$(printf '%s' "$match" | LC_ALL=C sed 's/^[[:space:]]*//' | clean_field)" "$(printf '%s' "$reason" | LC_ALL=C sed 's/^[[:space:]]*//' | clean_field)"
  done < "$TMP/acc.in"; }
# skip LABEL REASON: record a check that could not run.
skip() { printf 'other\t%s\t%s\t%s\n' "$1" "$2" "$(skip_row "$1")" >> "$SKIPS"; }
skip_reason() { awk -F'\t' -v l="$1" '$2 == l {print $3; exit}' "$SKIPS"; }
# readable PATH LABEL: succeeds when PATH is absent or can be read. Tries a real read: a privacy-protected file can pass -r.
readable() {
  [ -e "$1" ] || return 0
  if [ -d "$1" ]; then ls "$1" >/dev/null 2>&1 && return 0; else head -c 1 "$1" >/dev/null 2>&1 && return 0; fi
  skip "$2" "$1 is not readable; Full Disk Access for the terminal app may be needed"; return 1; }
# priv LABEL COMMAND ARGS...: run one command allowed by the macassay sudo rules. Fails when skipped.
priv() {
  local label="$1" rc; shift
  if [ ! -e "$RULES" ]; then printf 'priv\t%s\t%s\t%s\n' "$label" "macassay sudo rules not installed" "$(skip_row "$label")" >> "$SKIPS"; return 1; fi
  /usr/bin/sudo -n -k "$@" 2> "$TMP/priv.err"; rc=$?
  if classify_refusal "$rc" "$TMP/priv.err"; then printf 'priv\t%s\t%s\t%s\n' "$label" "refused or unavailable" "$(skip_row "$label")" >> "$SKIPS"; return 1; fi
  echo "$label" >> "$TMP/privran"; cat "$TMP/priv.err"; return 0; }
# enroll_state; stdin: profiles status -type enrollment output. Prints DEP<TAB>MDM, each Yes, No, or unknown.
enroll_state() { awk -F': ' '/^Enrolled via DEP:/ {d = $2} /^MDM enrollment:/ {m = $2}
  END { d = (d ~ /^Yes/ ? "Yes" : d ~ /^No/ ? "No" : "unknown"); m = (m ~ /^Yes/ ? "Yes" : m ~ /^No/ ? "No" : "unknown"); print d "\t" m }'; }
# read_enrollment: sets DEP and MDM from profiles status, which needs no root. A failed or unclear answer gives unknown and a skip.
read_enrollment() { local e
  if e=$(profiles status -type enrollment 2>/dev/null); then IFS=$'\t' read -r DEP MDM <<< "$(printf '%s\n' "$e" | enroll_state)"
  else DEP=unknown; MDM=unknown; fi
  if [ "$DEP" = unknown ] || [ "$MDM" = unknown ]; then skip "Enrollment state" "profiles status -type enrollment failed or gave no answer"; fi; }
# write_meta: the run facts that every format needs, as KEY<TAB>VALUE lines in $TMP/meta.tsv.
write_meta() { local r=0 b=0; [ -e "$RULES" ] && r=1; [ -n "$BREW" ] && b=1
  printf '%s\t%s\n' host "$HOST" user "$TUSER" date "$NOW" epoch "$EPOCH" version "$VERSION" quick "$QUICK" \
    offline "$OFFLINE" skip_du "$SKIPDU" priv_ran "$NPR" priv_skipped "$NPS" other_skipped "$NOS" rules "$r" \
    brew "$b" dep "$DEP" mdm "$MDM" laptop "$HASBAT" > "$TMP/meta.tsv"; }
# privblk "title" LABEL COMMAND ARGS...: priv output as a block, or a skipped line.
# A missing file or folder prints "none".
privblk() { local t="$1" l="$2"; shift 2
  if priv "$l" "$@" > "$TMP/pb"; then drop_enoent < "$TMP/pb" | block "$t"; else say "- $t: skipped ($(skip_reason "$l"))"; fi; }
# drop_enoent; prints nothing when the whole input is one missing-file error, else the input unchanged.
# Only a whole-output match counts: a file name in an existing folder must never hide its own line.
# ssh-keygen ends its errors with \r\n.
drop_enoent() { awk '{ l[NR] = $0 } END { x = l[1]; sub(/\r$/, "", x)
  if (NR == 1 && x ~ /^(ls|ssh-keygen): .*: No such file or directory$/) exit
  for (i = 1; i <= NR; i++) print l[i] }'; }
sig()  { # signer summary for a path
  [ -e "$1" ] || { echo "missing"; return; }
  local o; o=$(codesign -dv "$1" 2>&1)
  case "$o" in
    *"not signed"*) echo "unsigned" ;;
    *"Signature=adhoc"*) echo "ad hoc" ;;
    *"Authority=Software Signing"*|*"Platform identifier"*) echo "Apple" ;;
    *) echo "$o" | awk -F= '/^TeamIdentifier=/{print "Team " $2; f=1} END{if(!f) print "signed"}' ;;
  esac; }
plistprog(){ plutil -extract Program raw -o - "$1" 2>/dev/null || plutil -extract ProgramArguments.0 raw -o - "$1" 2>/dev/null; }
# chain_writable PATH...: prints "SEVERITY<TAB>reason" for the worst item on the paths, or a folder above
# them, that a non-root account can change. Admin-group write is MEDIUM only under /Applications, where
# macOS grants it by default (decision G3); group wheel holds only root on macOS.
chain_writable() {
  local p d o perm grp hit=""
  for p in "$@"; do
    [ -n "$p" ] || continue
    d="$p"
    while :; do
      if [ -e "$d" ] || [ -L "$d" ]; then
        o=$(stat -f '%Su %Sp %Sg' "$d" 2>/dev/null); perm=$(echo "$o" | awk '{print $2}'); grp=${o##* }
        case "$o" in
          "root "*) ;;
          *) printf 'HIGH\t%s is owned by %s\n' "$d" "${o%% *}"; return 0 ;;
        esac
        if [ ! -L "$d" ]; then
          [ "${perm:8:1}" = w ] && { printf 'HIGH\t%s is writable by everyone\n' "$d"; return 0; }
          if [ "${perm:5:1}" = w ]; then
            case "$grp" in
              wheel) ;;
              admin) case "$d" in
                       /Applications|/Applications/*) [ -z "$hit" ] && hit="$d is writable by the admin group" ;;
                       *) printf 'HIGH\t%s is writable by the admin group\n' "$d"; return 0 ;;
                     esac ;;
              *) printf 'HIGH\t%s is writable by group %s\n' "$d" "$grp"; return 0 ;;
            esac
          elif [ -w "$d" ]; then printf 'HIGH\t%s is writable by %s through an ACL\n' "$d" "$(id -un)"; return 0; fi
        fi
      fi
      [ "$d" = / ] && break
      d=$(dirname "$d")
    done
  done
  [ -n "$hit" ] && printf 'MEDIUM\t%s\n' "$hit"; }

# ---------- modes other than the audit ----------
print_sudoers_mode() {
  collect_accounts | gen_rules "${SUSER:-$(id -un)}" "$(uname -m)"; exit $?; }

sudoers_ok() { /usr/sbin/visudo -c >/dev/null 2>&1; }

# Puts back $TMP/old as $RULES, or removes $RULES when there was none or it cannot be put back.
# Returns 0 when the previous state is back, 2 when the old rules were lost but sudo parses, 1 when sudo still does not parse.
rollback_rules() {
  local new; new="$(dirname "$RULES")/.macassay.new"
  if [ -f "$TMP/old" ] && { /usr/bin/install -o root -g wheel -m 0440 "$TMP/old" "$new" && mv -f "$new" "$RULES"; } 2>/dev/null; then
    sudoers_ok; return; fi
  rm -f "$new" "$RULES"
  sudoers_ok || return 1
  [ -f "$TMP/old" ] && return 2
  return 0; }

install_mode() {
  local user="${SUSER:-$SUDO_USER}" d folders
  [ "$(id -u)" -eq 0 ] || die "--install-sudoers needs root. Run: sudo $0 --install-sudoers"
  [ -n "$user" ] || die "Name the user to grant: --install-sudoers=USER" 2
  sudoers_ok || die "visudo -c fails on the current sudo configuration. Fix it before installing."
  collect_accounts | gen_rules "$user" "$(uname -m)" > "$TMP/rules" || exit 1
  /usr/sbin/visudo -c -f "$TMP/rules" >/dev/null || die "The generated rules fail visudo -c -f; nothing was installed."
  # A folder the user can write on a rule path would let a symlink point the rule at another file.
  awk '/^    \// { sub(/, \\$/, ""); for (i = 2; i <= NF; i++) if ($i ~ /^\//) print $i }' "$TMP/rules" |
    while read -r d; do d=$(dirname "$d"); while :; do echo "$d"; [ "$d" = / ] && break; d=$(dirname "$d"); done; done |
    sort -u > "$TMP/dirs"
  # One sudo call for every folder, because each sudo call in a terminal writes a login record.
  folders=(); while IFS= read -r d; do folders+=("$d"); done < "$TMP/dirs"
  # shellcheck disable=SC2024  # the installer, as root, writes the result file, not the user
  sudo -u "$user" /bin/sh -c "$WRITABLE_SH" sh "${folders[@]}" > "$TMP/writable"
  [ -s "$TMP/writable" ] && die "$user can write these folders on rule paths; nothing was installed:
$(cat "$TMP/writable")"
  if [ -f "$RULES" ] && cmp -s "$TMP/rules" "$RULES"; then echo "The macassay rules are already installed for $user."; exit 0; fi
  if [ -f "$RULES" ]; then echo "Replacing $RULES. Changes:"; diff "$RULES" "$TMP/rules"; cp "$RULES" "$TMP/old" || die "Could not back up $RULES; nothing was installed."; fi
  /usr/bin/install -o root -g wheel -m 0440 "$TMP/rules" /etc/sudoers.d/.macassay.new || die "Could not write /etc/sudoers.d/.macassay.new"
  mv -f /etc/sudoers.d/.macassay.new "$RULES" || { rm -f /etc/sudoers.d/.macassay.new; die "Could not install $RULES"; }
  if ! sudoers_ok; then
    rollback_rules; case $? in
      0) die "visudo -c failed after the install, so the previous state was restored." ;;
      2) die "visudo -c failed after the install, and the previous rules could not be put back. $RULES was removed; sudo works without the macassay rules." ;;
    esac
    die "visudo -c failed after the install, and restoring the previous state also failed. sudo may refuse every command. Recover without sudo:
osascript -e 'do shell script \"rm $RULES\" with administrator privileges'"
  fi
  echo "Installed $RULES for $user."
  if sudo -u "$user" /usr/bin/sudo -n -k /sbin/pfctl -s info >/dev/null 2>&1; then echo "Verified: $user can run a macassay rule without a password."
  else echo "Warning: $user cannot run the macassay rules. A later line in /etc/sudoers may override them, or sudoers.d may not be included." >&2; fi
  grep -Eq '^[#@]includedir[[:space:]]+(/private)?/etc/sudoers\.d/?[[:space:]]*$' /etc/sudoers ||
    echo "Warning: /etc/sudoers has no includedir line for /etc/sudoers.d, so sudo ignores the rules." >&2
  echo "Undo: sudo rm $RULES"
  exit 0; }

# write_bundle DIR: the remote result, exactly five lines: a version line, then the four data files as base64 without line breaks.
write_bundle() { local f; echo "macassay-bundle 1"
  for f in meta.tsv findings.tsv skipped.tsv body.md; do /usr/bin/base64 < "$1/$f" | tr -d '\n'; echo; done; }
# read_bundle FILE DIR: decodes a bundle into fixed file names in DIR. The bundle comes from the audited Mac, so every line
# is checked against the base64 alphabet before decoding (base64 -D exits 0 on some invalid input), and no name or path
# comes from it. bash 3.2 read drops NUL bytes silently, so a file that holds one is rejected first.
read_bundle() { local l f re='^[A-Za-z0-9+/]*={0,2}$'
  if [ "$(tr -d '\0' < "$1" | wc -c)" -ne "$(wc -c < "$1")" ]; then return 1; fi
  { IFS= read -r l && [ "$l" = "macassay-bundle 1" ] || return 1
    for f in meta.tsv findings.tsv skipped.tsv body.md; do
      IFS= read -r l || return 1
      [[ $l =~ $re ]] && [ $(( ${#l} % 4 )) -eq 0 ] || return 1
      printf '%s' "$l" | /usr/bin/base64 -D > "$2/$f" 2>/dev/null || return 1
    done
    if IFS= read -r l || [ -n "$l" ]; then return 1; fi; } < "$1"; }

remote_mode() {
  local target ssho os b64 rcmd pass rc
  [ -f "$0" ] || die "Remote mode needs the script file on disk." 2
  target="$RHOST"; [ -n "$RUSER" ] && target="$RUSER@$RHOST"
  ssho=(-o BatchMode=yes -o ConnectTimeout=10)
  [ -n "$RKEY" ] && { [ -r "$RKEY" ] || die "Cannot read key: $RKEY" 2; ssho+=(-i "$RKEY" -o IdentitiesOnly=yes); }
  [ -n "$RPORT" ] && ssho+=(-p "$RPORT")
  [ -n "$RKH" ] && ssho+=(-o UserKnownHostsFile="$RKH")
  os=$(/usr/bin/ssh "${ssho[@]}" "$target" /usr/bin/uname -s </dev/null 2>&1) || die "SSH to $target failed: $os"
  [ "$os" = Darwin ] || die "$target is not macOS (uname: $os)."
  b64=$(/usr/bin/base64 < "$0" | tr -d '\n')
  # Absolute paths: the remote PATH comes from user-writable startup files.
  rcmd="/bin/bash -c \"\$(/usr/bin/printf %s '$b64' | /usr/bin/base64 -D)\" macassay"
  # shellcheck disable=SC2029  # $rcmd is expanded locally on purpose: base64 text and fixed options only.
  case "$MODE" in
    print-sudoers) /usr/bin/ssh "${ssho[@]}" "$target" "$rcmd --print-sudoers${SUSER:+=$SUSER}" </dev/null; exit $? ;;
    install-sudoers) /usr/bin/ssh -t "${ssho[@]}" "$target" "/usr/bin/sudo $rcmd --install-sudoers${SUSER:+=$SUSER}"; exit $? ;;
  esac
  pass="--bundle"; [ "$QUICK" -eq 1 ] && pass="$pass --quick"; [ "$OFFLINE" -eq 1 ] && pass="$pass --offline"; [ "$SKIPDU" -eq 1 ] && pass="$pass --skip-du"
  DEFBASE="./macassay-${RHOST}-$(date +%Y%m%d-%H%M)"
  echo "Auditing $target over SSH..." >&2
  # shellcheck disable=SC2029  # as above
  /usr/bin/ssh "${ssho[@]}" "$target" "$rcmd $pass" </dev/null > "$TMP/bundle"; rc=$?
  [ "$rc" -eq 0 ] || die "Remote audit failed (exit $rc)."
  mkdir "$TMP/rb" || exit 1
  read_bundle "$TMP/bundle" "$TMP/rb" || die "Remote audit returned a malformed result."
  render_all "$TMP/rb"; exit $?; }

# recent_installs CUTOFF; stdin: plutil -p of /Library/Receipts/InstallHistory.plist.
# Prints "date  name version" for each install on or after CUTOFF (YYYY-MM-DD) that Apple did not make.
# An install counts as Apple's only when an Apple update process made it, or when the App Store or the Rosetta
# prompt (CoreServicesUIAgent) made it with a com.apple. package ID. Any package can claim a com.apple. ID, so a
# hand-installed one stays listed.
recent_installs() {
  awk -v c="$1" '
    /^  [0-9]+ => \{/ { d = n = v = p = k = ""; next }
    /^    "date" => / { d = $3 }
    /^    "displayName" => / { n = $0; sub(/^[^>]*> "/, "", n); sub(/"$/, "", n) }
    /^    "displayVersion" => / { v = $0; sub(/^[^>]*> "/, "", v); sub(/"$/, "", v) }
    /^    "processName" => / { p = $0; sub(/^[^>]*> "/, "", p); sub(/"$/, "", p) }
    /^      0 => "/ && k == "" { k = $0; sub(/^[^>]*> "/, "", k); sub(/"$/, "", k) }
    /^  \}/ { if (d < c || p ~ /^(softwareupdated|softwareupdate|XProtectUpdateService|bootinstalld)$/ || (p ~ /^(appstoreagent|appstored|CoreServicesUIAgent)$/ && k ~ /^com\.apple\./)) next
      print d "  " (n != "" ? n : k) (v != "" ? " " v : "") }'; }
# top_mem; stdin: ps -axo rss=,pcpu=,pid=,user=,comm=. The program path may hold spaces, so it is the rest of the line.
top_mem() { awk '{ c = $0; sub(/^ *[^ ]+ +[^ ]+ +[^ ]+ +[^ ]+ +/, "", c); printf "%7.0f MB %5s%% %6s %-10s %s\n", $1/1024, $2, $3, $4, c }'; }
# crash_kinds; stdin: report paths. Counts reports by program; .ips names put "-" before the date, .diag names "_".
crash_kinds() { sed 's#.*/##' | sed -E 's/[-_][0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]+.*//' | sort | uniq -c | sort -rn | head -25; }
# xprotect_versions; stdin: system_profiler SPInstallHistoryDataType. Prints the latest version of each XProtect component.
xprotect_versions() {
  awk '/^    XProtect[^:]*:$/ { n = $1; sub(/:$/, "", n); next }
    n != "" && /^      Version:/ { v[n] = $2; n = "" }
    END { for (k in v) print k, v[k] }' | sort; }
# btm_unique; stdin: Name, Type and similar lines from sfltool dumpbtm. Prints each item once; dumpbtm repeats items per account.
btm_unique() {
  awk 'function flush() { if (r != "" && !(r in s)) { s[r] = 1; printf "%s", r }; r = "" }
    /^[[:space:]]+Name:/ { flush() } { r = r $0 "\n" } END { flush() }'; }
# outbound_conns PSMAP; stdin: ESTABLISHED lines of netstat -anv. PSMAP holds "pid program" lines from ps.
# Prints "process remote-address" for each non-local connection. The name comes from ps, because netstat
# cuts long names and the field splits at spaces.
outbound_conns() {
  awk -v map="$1" '
    BEGIN { while ((getline l < map) > 0) { sub(/^ +/, "", l); p = l; sub(/ .*/, "", p); c = l; sub(/^[0-9]+ +/, "", c); sub(/.*\//, "", c); name[p] = c } }
    { f = ""; for (i = 6; i <= NF; i++) if ($i ~ /^[^ ]+:[0-9]+$/) f = $i
      pid = f; sub(/.*:/, "", pid); n = f; sub(/:[0-9]+$/, "", n); if (pid in name) n = name[pid]
      r = $5; sub(/\.[0-9]+$/, "", r); if (r !~ /^(127\.|::1|fe80)/) print n, r }'; }
# nmh_label FOLDER: the browser part of a native-messaging folder, such as "Google/Chrome".
nmh_label() { local d="${1%/NativeMessagingHosts}"; d="${d#"$THOME"/Library/Application Support/}"; d="${d#/Library/Application Support/}"; printf '%s' "${d#/Library/}"; }
# boot_args_sev ARGS: prints HIGH for boot arguments that turn off code-signing enforcement, LOW for others.
boot_args_sev() { case "$1" in '') ;; *amfi_*|*cs_enforcement_disable*) echo HIGH ;; *) echo LOW ;; esac; }
# cups_shared FILE: succeeds when cupsd.conf listens beyond localhost, which printer sharing turns on.
cups_shared() { awk 'tolower($1) == "port" {f = 1} tolower($1) == "listen" && $2 !~ /^(localhost|127\.0\.0\.1|\[::1\]):/ && $2 !~ /^\// {f = 1} END {exit !f}' "$1" 2>/dev/null; }
# One row per remote-access tool: name, then lowercase regexes for names on disk and for process names ("-" for none).
# Each fragment avoids a known false match; dev/features/checks-1.4.md (Check 1) gives the reasons.
REMOTE_TOOLS='TeamViewer	teamviewer	teamviewer
AnyDesk	anydesk|philandro	anydesk
RustDesk	rustdesk|com[.]carriez	rustdesk
Chrome Remote Desktop	chromoting|chromeremotedesktop	remoting_me2me
Splashtop Streamer	splashtop.?streamer	splashtop.?streamer
ConnectWise ScreenConnect	screenconnect|connectwisecontrol	screenconnect|connectwisecontrol
BeyondTrust (Bomgar)	bomgar	bomgar
LogMeIn	logmein	logmein
GoTo Resolve	com[.]goto[.]resolve|resolve.unattended	resolve.unattended
RealVNC Server	realvnc	^vnc(server|agent)
NoMachine	nomachine	^nx(server|node)
Parsec	parsec	^parsec$
Zoho Assist	zohoassist|zoho assist	zohoassist
