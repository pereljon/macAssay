  for src in "managed:/Library/Managed Preferences/$dom.plist" "managed:/Library/Managed Preferences/$TUSER/$dom.plist" "local:/Library/Preferences/$dom.plist" "local:$THOME/Library/Preferences/$dom.plist"; do
